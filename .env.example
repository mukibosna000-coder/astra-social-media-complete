# Database
DATABASE_URL=postgresql://user:password@localhost:5432/custom_ai

# Encryption
CREDENTIAL_ENCRYPTION_KEY=your-32-byte-hex-key

# LLM Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk-...

# OAuth2 - Twitter/X
TWITTER_CLIENT_ID=your_client_id
TWITTER_CLIENT_SECRET=your_secret
TWITTER_REDIRECT_URI=http://localhost:3000/oauth/twitter

# OAuth2 - LinkedIn
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/oauth/linkedin

# OAuth2 - Reddit
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_secret
REDDIT_REDIRECT_URI=http://localhost:3000/oauth/reddit

# OAuth2 - Discord
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_secret
DISCORD_REDIRECT_URI=http://localhost:3000/oauth/discord

# OAuth2 - GitHub
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_secret
GITHUB_REDIRECT_URI=http://localhost:3000/oauth/github

# OAuth2 - Google
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google

# YouTube
YOUTUBE_API_KEY=your_api_key

# TikTok
TIKTOK_CLIENT_ID=your_client_id
TIKTOK_CLIENT_SECRET=your_secret
TIKTOK_REDIRECT_URI=http://localhost:3000/oauth/tiktok

# Twitch
TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_secret
TWITCH_REDIRECT_URI=http://localhost:3000/oauth/twitch

# Server
PORT=3000
NODE_ENV=development
